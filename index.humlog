<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>GS-CODE PRO - ULTRA</title>
<script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.44.0/min/vs/loader.js"></script>
<script src="https://cdn.jsdelivr.net/pyodide/v0.25.0/full/pyodide.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{background:#08080a;color:white;font-family:'Consolas',monospace;display:flex;flex-direction:column;height:100vh;overflow:hidden;position:relative}
.aurora{position:absolute;top:0;left:0;width:100%;height:100%;z-index:-2;overflow:hidden}
.blob{position:absolute;width:600px;height:600px;border-radius:50%;filter:blur(80px);opacity:0.35;animation:floatBlob 12s infinite ease-in-out}
.b1{background:linear-gradient(135deg,#ff0080,#7928ca);top:-10%;left:-10%}
.b2{background:linear-gradient(135deg,#00ff88,#00d2ff);top:20%;right:-15%}
.b3{background:linear-gradient(135deg,#ff8a00,#e52e71);bottom:-10%;left:30%}
.b4{background:linear-gradient(135deg,#7928ca,#ff0080);bottom:10%;right:20%}
@keyframes floatBlob{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(30px,-30px) scale(1.1)}66%{transform:translate(-20px,20px) scale(0.9)}}
.top{height:65px;display:flex;align-items:center;justify-content:space-between;padding:0 16px;background:rgba(15,15,18,0.85);backdrop-filter:blur(25px);border-bottom:1px solid rgba(255,255,255,0.1);z-index:10}
.logo{font-weight:900;font-size:20px;display:flex;align-items:center;gap:10px}
.logo.icon-box{width:38px;height:38px;background:linear-gradient(135deg,#ff0080,#7928ca,#00d2ff,#00ff88);background-size:300% 300%;border-radius:10px;display:flex;align-items:center;justify-content:center;animation:rainbowShift 3s linear infinite}
@keyframes rainbowShift{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
.logo-text{background:linear-gradient(90deg,#ff0080,#ff8a00,#00ff88,#00d2ff,#7928ca,#ff0080);background-size:300% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;animation:rainbowShift 4s linear infinite}
.logo span{font-size:10px;letter-spacing:3px;opacity:0.7;color:white;-webkit-text-fill-color:white;margin-left:4px}
.controls{display:flex;gap:10px;align-items:center}
select{padding:10px 14px;border-radius:10px;border:1px solid rgba(255,255,255,0.15);background:rgba(30,30,35,0.9);color:white;font-weight:bold;font-size:13px}
#run{padding:12px 28px;border-radius:14px;border:none;font-weight:900;font-size:14px;cursor:pointer;color:white;background:linear-gradient(135deg,#ff0080,#7928ca,#00d2ff);background-size:200% auto;animation:rainbowShift 2s linear infinite;display:flex;align-items:center;gap:8px;box-shadow:0 4px 20px #ff008055}
.main{display:flex;flex:1;overflow:hidden;gap:1px;background:rgba(255,255,255,0.05)}
.sidebar{width:60px;background:rgba(15,15,18,0.9);display:flex;flex-direction:column;align-items:center;padding-top:20px;gap:20px}
.icon{width:44px;height:44px;display:flex;align-items:center;justify-content:center;border-radius:12px;font-size:18px;opacity:0.4}
.icon.active{opacity:1;background:linear-gradient(135deg,rgba(255,0,128,0.2),rgba(121,40,202,0.2));color:#ff8a00;border:1px solid rgba(255,0,128,0.3)}
#editor{flex:1;background:#0e0e12}
.right{width:40%;background:rgba(10,10,12,0.9);display:flex;flex-direction:column;border-left:1px solid rgba(255,255,255,0.08)}
.tabs{display:flex;background:rgba(20,20,24,0.9);padding:6px;gap:6px}
.tab{padding:9px 16px;font-size:11px;border-radius:9px;opacity:0.5}
.tab.active{opacity:1;background:linear-gradient(135deg,rgba(255,0,128,0.15),rgba(0,210,255,0.15));color:#00ff88}
#output{background:rgba(0,0,0,0.6);flex:1;padding:14px;font-size:13px;overflow:auto;white-space:pre-wrap;line-height:1.7}
.term-ok{color:#00ff88}.term-err{color:#ff4d7a}.term-line{color:#888}
#inputBox{display:none;padding:12px;background:rgba(20,20,24,0.95);border-top:1px solid rgba(255,0,128,0.3)}
#inputBox input{width:100%;padding:14px;background:#000;border:1px solid rgba(255,255,255,0.1);border-radius:12px;color:white;outline:none}

/* ANDROID FLOATING RUN BUTTON - YE NAYA HAI */
#runMobile{display:none}
@media(max-width:768px){
.main{flex-direction:column}#editor{height:48vh!important;flex:none}.right{width:100%;height:52vh}.sidebar{display:none}
.top{height:58px}.logo{font-size:18px}
 #run{display:none} /* upar wala hide */
 #runMobile{
  display:flex;
  position:fixed;
  bottom:24px;
  right:20px;
  z-index:999;
  width:64px;height:64px;
  border-radius:50%;
  border:none;
  background:linear-gradient(135deg,#ff0080,#7928ca,#00d2ff);
  background-size:200% auto;
  animation:rainbowShift 2s linear infinite;
  box-shadow:0 8px 25px rgba(255,0,128,0.5), 0 0 0 6px rgba(255,0,128,0.1);
  align-items:center;justify-content:center;
  font-size:26px;color:white;
  cursor:pointer;
 }
 #runMobile:active{transform:scale(0.92)}
}
</style>
</head>
<body>
<div class="aurora"><div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div><div class="blob b4"></div></div>
<div class="top">
<div class="logo"><div class="icon-box"><i class="fas fa-bolt"></i></div><div class="logo-text">GS-CODE</div><span>PRO</span></div>
<div class="controls">
<select id="lang"><option value="python">🐍 Python</option><option value="javascript">⚡ JavaScript</option><option value="c">🔷 C</option><option value="cpp">💎 C++</option><option value="html">🎨 HTML</option></select>
<button id="run" onclick="runCode()"><i class="fas fa-play"></i> RUN</button>
</div>
</div>
<div class="main">
<div class="sidebar"><div class="icon active"><i class="fas fa-code"></i></div><div class="icon"><i class="fas fa-layer-group"></i></div><div class="icon"><i class="fas fa-fire"></i></div></div>
<div id="editor"></div>
<div class="right">
<div class="tabs"><div class="tab active">TERMINAL</div><div class="tab">OUTPUT</div></div>
<div id="output"><span class="term-line">// GS-CODE PRO - LOADED</span>
<span class="term-ok">> Engine ready ✅</span>
<span class="term-line">> Android mode active - Neeche wala bada button dabao 🚀</span></div>
<div id="inputBox"><input id="userInput" placeholder="Input likho aur Enter dabao..."></div>
</div>
</div>

<!-- ANDROID KE LIYE BADA GOL RUN BUTTON -->
<button id="runMobile" onclick="runCode()"><i class="fas fa-play"></i></button>

<script>
let editor, pyodide, waitingForInput=null;
const codes={
python:`# GS-CODE PRO
import random
print("✨ GS-CODE PRO ✨")
name1 = input("Pehla Naam: ")
name2 = input("Dusra Naam: ")
score = random.randint(70,100)
print(f"\\n💖 {name1} ❤️ {name2} = {score}% 💖")
if score>90: print("🔥 SOULMATES 🔥")
else: print("✨ Dosti ✨")`,
javascript:`console.log("✨ GS-CODE PRO ✨");
let s=Math.floor(Math.random()*31)+70;
console.log("💖 Result = "+s+"% 💖");`,
c:`#include <stdio.h>\nint main(){printf("✨ GS-CODE PRO C ✨\\n");printf("💖 92%% 💖\\n");return 0;}`,
cpp:`#include <bits/stdc++.h>\nusing namespace std;\nint main(){cout<<"✨ GS-CODE PRO C++ ✨\\n💖 92% 💖\\n";return 0;}`,
html:`<!DOCTYPE html><html><body style="margin:0;background:#08080a;color:white;text-align:center;padding:40px;font-family:Arial"><h1 style="background:linear-gradient(90deg,#ff0080,#00d2ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-size:50px">GS-CODE PRO</h1><div style="background:rgba(255,255,255,0.05);padding:25px;border-radius:20px;max-width:340px;margin:30px auto"><h2>92% 💖</h2><button style="background:linear-gradient(135deg,#ff0080,#7928ca);border:none;padding:12px 24px;border-radius:10px;color:white;font-weight:800">Check Again</button></div></body></html>`
};
require.config({paths:{'vs':'https://cdn.jsdelivr.net/npm/monaco-editor@0.44.0/min/vs'}});
require(['vs/editor/editor.main'],function(){
 editor=monaco.editor.create(document.getElementById('editor'),{value:codes.python,language:'python',theme:'vs-dark',fontSize:14,minimap:{enabled:false},automaticLayout:true,wordWrap:'on'});
 document.getElementById('lang').addEventListener('change',e=>{
  let l=e.target.value; let m={python:'python',javascript:'javascript',c:'c',cpp:'cpp',html:'html'};
  monaco.editor.setModelLanguage(editor.getModel(),m[l]); editor.setValue(codes[l]);
 });
});
function addOut(t,cls=""){let o=document.getElementById('output');let d=document.createElement('div');d.className=cls;d.textContent=t;o.appendChild(d);o.scrollTop=o.scrollHeight;}
async function loadPy(){if(!pyodide){addOut("Loading... ⏳","term-line");pyodide=await loadPyodide();addOut("Ready! ✅","term-ok");}}
async function runCode(){
 let btn = window.innerWidth <= 768? document.getElementById('runMobile') : document.getElementById('run');
 if(btn) { let old = btn.innerHTML; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>'; setTimeout(()=>btn.innerHTML=old,1000); }
 let lang=document.getElementById('lang').value,code=editor.getValue();
 document.getElementById('output').innerHTML="";addOut("🚀 Running "+lang+"...","term-line");
 if(lang==='python'){await loadPy();try{pyodide.setStdout({batched:s=>addOut(s,"term-ok")});pyodide.setStdin({stdin:()=>new Promise(res=>{document.getElementById('inputBox').style.display='block';document.getElementById('userInput').focus();waitingForInput=v=>{res(v);document.getElementById('inputBox').style.display='none';document.getElementById('userInput').value='';waitingForInput=null;};})});await pyodide.runPythonAsync(code);addOut("\n> Done ✅","term-ok");}catch(e){addOut(e.message,"term-err");}}
 else if(lang==='javascript'){try{let logs=[];let o=console.log;console.log=(...a)=>logs.push(a.join(' '));eval(code);console.log=o;logs.forEach(l=>addOut(l,"term-ok"));}catch(e){addOut(e.message,"term-err");}}
 else if(lang==='c'||lang==='cpp'){try{let r=await fetch("https://emkc.org/api/v2/piston/execute",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({language:lang==='c'?'c':'c++',version:"*",files:[{content:code}]})});let d=await r.json();addOut(d.run.stdout||"","term-ok");if(d.run.stderr)addOut(d.run.stderr,"term-err");}catch(e){addOut("Net Error","term-err");}}
 else{let w=window.open();w.document.write(code);w.document.close();addOut("> Preview Opened ✨","term-ok");}
}
document.getElementById('userInput').addEventListener('keydown',e=>{if(e.key==='Enter'&&waitingForInput){addOut("> "+e.target.value,"term-line");waitingForInput(e.target.value+"\n");}});
</script>
</body>
  </html>
